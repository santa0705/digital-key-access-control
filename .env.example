# Digital Key-Based Secure Access Control - Environment Variables Template
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit the real .env file or real secrets to version control.

# PostgreSQL connection string (SQLAlchemy 2 with psycopg 3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://digital_key_user:your_db_password_here@localhost:5432/digital_key

# Authentication secrets
# JWT secret for signing session tokens (HS256)
JWT_SECRET=replace_with_generated_jwt_secret_hex_32_bytes

# Credential protection keys
# HMAC key for verifying 6-digit PIN hashes (hex format)
PIN_HMAC_KEY=replace_with_generated_hmac_key_hex_32_bytes

# Fernet encryption key for reversible PIN storage (base64 format, 32 bytes)
PIN_ENC_KEY=replace_with_generated_fernet_key_base64_32_bytes

# Shared API key for device authentication (ESP32 / Mock client)
DEVICE_API_KEY=replace_with_generated_device_api_key

# CORS allowed origins (comma-separated if multiple)
CORS_ORIGINS=http://localhost:5173

# Alembic Migration Target Safety Guard (FAIL-CLOSED DEFAULT)
# Migrations are strictly disabled by default to prevent accidental execution against shared databases.
# To run migrations locally against a disposable test/dev database, explicitly set ALLOW_LOCAL_MIGRATION=true
# and ensure your target host, port, db name, and user match the allowlist below.
ALLOW_LOCAL_MIGRATION=false
APPROVED_MIGRATION_HOSTS=localhost,127.0.0.1,::1
APPROVED_MIGRATION_PORTS=5432
APPROVED_MIGRATION_DB_NAMES=digital_key
APPROVED_MIGRATION_USERS=

# Production migration authorization settings (strictly disabled by default)
ALLOW_PRODUCTION_MIGRATION=false
APPROVED_PRODUCTION_HOSTS=ep-sparkling-salad-b5pw9aqb-pooler.c-7.us-east-2.aws.neon.tech,ep-sparkling-salad-b5pw9aqb.c-7.us-east-2.aws.neon.tech
APPROVED_PRODUCTION_DB_NAMES=neondb
